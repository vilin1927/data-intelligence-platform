# Database. The AI assistant uses the read-only connection.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/moppity_db
DATABASE_URL_READONLY=postgresql://READONLY_USER:PASSWORD@localhost:5432/moppity_db

# Auth: one shared password, HMAC-signed session cookie.
# SESSION_SECRET must be at least 32 characters.
DASHBOARD_PASSWORD=
SESSION_SECRET=
HTTPS_ENABLED=false

# AI assistant
ANTHROPIC_API_KEY=

# Source-system sync triggered from the dashboard
VINSIGHT_API_KEY=
GOOGLE_API_KEY=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TOKEN_FILE=

# Optional
RECONCILIATION_ENABLED=false
VIEW_ONLY=false
NEXT_PUBLIC_VIEW_ONLY=false
DEMO_CHAT_ENABLED=false
MOPPITY_PREFLIGHT_TOKEN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENV=
NEXT_PUBLIC_SENTRY_ENV=
